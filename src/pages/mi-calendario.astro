---
// Servidor (PLAN.md, sección 3 y CLAUDE.md, convenciones técnicas: junto
// con api/* es de las pocas rutas que corren en Vercel Functions). Sin
// cookie válida, redirige a /canje.
export const prerender = false;

import Base from "../layouts/Base.astro";
import CalendarioDesbloqueado from "../components/canje/CalendarioDesbloqueado.astro";
import CanjeNav from "../components/canje/CanjeNav.astro";
import { COOKIE_SESION, verificarSesion } from "../server/canje";

const sesion = verificarSesion(Astro.cookies.get(COOKIE_SESION)?.value);
if (!sesion.valida) {
  return Astro.redirect("/canje");
}
---

<Base title="Mi calendario de becas · Study Abroad Fest" description="Tu Calendario de becas desbloqueado." noindex>
  <div class="min-h-screen overflow-hidden bg-[linear-gradient(180deg,#3B99D8_0%,#66B3EA_38%,#6258BB_100%)]">
    <CanjeNav current="calendario" />
    <main class="relative">
      <div class="pointer-events-none absolute -top-24 right-[-100px] size-72 rounded-full bg-paper/20 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute bottom-10 left-[-120px] size-80 rounded-full bg-magenta/20 blur-3xl" aria-hidden="true"></div>
      <CalendarioDesbloqueado ultimos4={sesion.ultimos4} />
    </main>
  </div>
</Base>
