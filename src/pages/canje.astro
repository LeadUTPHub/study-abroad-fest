---
// Estática (PLAN.md, sección 3): la validación real ocurre en
// POST /api/canje (on-demand). Mobile primero (design/canvas/Canje-Mobile.dc.html).
import Base from "../layouts/Base.astro";
import FormCodigo from "../components/canje/FormCodigo.astro";
import CanjeNav from "../components/canje/CanjeNav.astro";
---

<Base title="Canjea tu código · Study Abroad Fest" description="Canjea el código de tu pasaporte y desbloquea el Calendario de becas.">
  <div class="min-h-screen overflow-hidden bg-[linear-gradient(180deg,#3B99D8_0%,#66B3EA_44%,#6258BB_100%)]">
    <CanjeNav current="canje" />
    <main class="relative">
      <div class="pointer-events-none absolute -top-20 right-[-90px] size-64 rounded-full bg-paper/20 blur-2xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute bottom-24 left-[-110px] size-72 rounded-full bg-magenta/20 blur-3xl" aria-hidden="true"></div>
      <FormCodigo />
    </main>
  </div>
</Base>
