---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import Hero from "../components/viaje/Hero.astro";
import Cronograma from "../components/Cronograma.astro";
import Ponentes from "../components/Ponentes.astro";
import Stands from "../components/Stands.astro";
import PasaporteSeccion from "../components/PasaporteSeccion.astro";
import PaseAbordaje from "../components/PaseAbordaje.astro";
import Faq from "../components/Faq.astro";
import CtaFinal from "../components/CtaFinal.astro";
import SiteFooter from "../components/SiteFooter.astro";
import DockMovil from "../components/DockMovil.astro";
import RoadDivider from "../components/ui/RoadDivider.astro";
---

<Base
  title="Study Abroad Fest 2026"
  description="Becas, intercambios y universidades del mundo en una sola tarde. Sábado 10 de octubre, Convention Center UTP, Lima."
>
  <SiteNav />
  <main>
    <Hero />
    <RoadDivider />
    <Cronograma />
    <Ponentes />
    <Stands />
    <PasaporteSeccion />
    <PaseAbordaje>
      <Faq />
    </PaseAbordaje>
    <CtaFinal />
  </main>
  <SiteFooter />
  {/* Reserva el espacio del dock fijo para que no tape el footer en celular. */}
  <div class="h-[68px] lg:hidden" aria-hidden="true"></div>
  <DockMovil />
</Base>
