---
// Formulario de canje (design/canvas/Canje-Mobile.dc.html, estado
// "locked"). Página estática (canje.astro): la validación real ocurre en
// POST /api/canje, que además revisa el horario de activación en el
// servidor. Este componente solo mejora la experiencia con JS:
// - antes de la activación, cambia el formulario por un aviso;
// - después del evento, cambia el panel de ayuda por un contacto;
// - normaliza el código mientras se escribe y prellena `?c=`.
// Sin JS, el formulario sigue funcionando (solo que sin esos avisos
// tempranos: el servidor responde igual con el error correcto).
import evento from "../../data/evento";
import stands from "../../data/stands";
import { momentoActivacion } from "../../server/canje";
import { fechaHoraLima, formatoFechaCorta, formatoHora12 } from "../../lib/fechas";
import Button from "../ui/Button.astro";
import Sello from "../ui/Sello.astro";

const activacionISO = momentoActivacion().toISOString();
const finEventoISO = fechaHoraLima(evento.fecha, evento.horaFin).toISOString();
const standsConfirmados = stands.filter((s) => s.estado === "confirmado");
const coloresSello = ["#6258BB", "#AC0BAD", "#2F86C4", "#525F97"];
---

<div
  id="canje-raiz"
  data-activacion={activacionISO}
  data-fin-evento={finEventoISO}
  class="mx-auto flex max-w-[520px] flex-col gap-5 px-4 py-6 text-paper sm:px-6"
>
  <div class="passport-illustration self-center rounded-2xl bg-paper p-4 shadow-[0_6px_0_rgba(29,33,82,.18)]">
    <div class="grid grid-cols-2 gap-2.5">
      {standsConfirmados.map((s, i) => (
        <div class="grid aspect-square place-items-center rounded-xl border-2 border-lav p-1">
          <Sello shape="circulo" size={64} color={coloresSello[i % coloresSello.length]} rotate={i % 2 === 0 ? "-10deg" : "8deg"}>
            {s.nombre}
          </Sello>
        </div>
      ))}
    </div>
    <div class="mt-2 text-center font-mono text-[11px] text-ink-2">Pasaporte con sellos → código</div>
  </div>

  <div id="canje-no-disponible" hidden class="rounded-2xl bg-ink/20 p-5 text-center">
    <div class="font-display text-2xl leading-tight">Disponible el día del evento</div>
    <p class="m-0 mt-2 text-[15px] font-semibold leading-relaxed">
      El canje se activa el {formatoFechaCorta(evento.fecha)}, a las {formatoHora12(evento.horaInicio)}.
    </p>
  </div>

  <div id="canje-formulario">
    <h1 class="m-0 font-display text-4xl leading-none [text-shadow:0_4px_0_rgba(29,33,82,.2)] sm:text-5xl">
      Canjea tu Calendario de becas
    </h1>
    <p class="m-0 mt-3 text-lg font-bold leading-snug">
      Ingresa el código que te dieron en la mesa de canje al completar tu pasaporte.
    </p>

    <form id="form-codigo" class="mt-5 flex flex-col gap-3 rounded-[20px] bg-paper p-5 text-ink shadow-[0_6px_0_rgba(29,33,82,.16)]" novalidate>
      <label for="codigo" class="font-mono text-xs font-semibold uppercase tracking-[.12em] text-ink-2">
        Tu código
      </label>
      <input
        id="codigo"
        name="codigo"
        placeholder="SAF-XXXX-XXXX"
        autocomplete="off"
        autocapitalize="characters"
        inputmode="text"
        aria-describedby="codigo-error"
        class="w-full rounded-xl border-2 border-lav bg-paper-2 p-3.5 font-mono text-xl font-semibold tracking-[.08em] text-ink uppercase"
      />
      <div id="codigo-error" role="alert" class="hidden text-sm font-bold text-magenta">
        Ese código no es válido. Revisa que esté completo, con el formato SAF-XXXX-XXXX.
      </div>
      <Button type="submit" variant="gradient" size="md" class="justify-center">
        Desbloquear calendario
      </Button>
      <div class="text-center text-[13px] text-ink-2">
        Tip: escanea el QR de tu pasaporte y el código se llena solo.
      </div>
    </form>

    <div id="canje-ayuda-antes" class="mt-4 flex flex-col gap-2 rounded-2xl bg-ink/20 p-4">
      <div class="text-base font-extrabold">¿Aún no tienes código?</div>
      <div class="text-[15px] leading-relaxed">
        Pide tu pasaporte al ingresar al evento, visita cada stand y ve a la mesa de canje con todos
        los sellos.
      </div>
    </div>
    <div id="canje-ayuda-despues" hidden class="mt-4 flex flex-col gap-2 rounded-2xl bg-ink/20 p-4">
      <div class="text-base font-extrabold">¿Perdiste tu código?</div>
      <div class="text-[15px] leading-relaxed">
        {evento.contactoSoporte
          ? `Escríbenos a ${evento.contactoSoporte}.`
          : "Escríbenos (el contacto todavía se está confirmando)."}
      </div>
    </div>
  </div>
</div>

<script>
  import { armarFormularioCodigo } from "../../lib/canje-cliente";
  armarFormularioCodigo();
</script>
