---
// Vista desbloqueada de /mi-calendario (design/canvas/Canje-Mobile.dc.html).
// tips.ts SOLO se importa acá, en un componente que únicamente se
// renderiza dentro de una página con `prerender = false` (CLAUDE.md,
// regla 10): nunca llega a una página prerenderizada ni al cliente.
import evento from "../../data/evento";
import postulaciones from "../../data/postulaciones";
import tips from "../../data/tips";
import Button from "../ui/Button.astro";
import TarjetaConvocatoria from "./TarjetaConvocatoria.astro";

interface Props {
  ultimos4: string;
}

const { ultimos4 } = Astro.props;
const anio = evento.fecha.slice(0, 4);

const confirmadas = postulaciones.filter((p) => p.estado === "confirmado");
const tipsPorConvocatoria = new Map(tips.map((t) => [t.convocatoriaId, t]));
---

<div class="mx-auto flex max-w-[560px] flex-col gap-6 px-4 py-8 sm:px-6 sm:py-12">
  <div class="relative overflow-hidden rounded-[24px] border-[5px] border-paper bg-paper p-5 shadow-[0_8px_0_rgba(29,33,82,.16),0_18px_30px_-18px_rgba(29,33,82,.55)] sm:p-6">
    <div class="approved-stamp absolute right-3.5 top-3.5 grid h-[92px] w-[92px] -rotate-12 place-items-center rounded-full border-4 border-magenta text-center font-mono text-[11px] font-semibold leading-tight text-magenta">
      APROBADO<br />SAF {anio}
    </div>
    <div class="font-mono text-xs font-semibold uppercase tracking-[.12em] text-violet">
      Código SAF-····-{ultimos4}
    </div>
    <h1 class="m-0 mt-2 max-w-[9em] font-display text-4xl leading-none text-ink">
      Tu calendario está listo
    </h1>
    <p class="m-0 mt-2 text-[15px] leading-relaxed text-ink-2">
      Guárdalo ahora. Tu código funciona en hasta 3 dispositivos.
    </p>
    <div class="mt-3.5 flex flex-col gap-2.5">
      <Button href="/api/descarga/pdf" variant="gradient" size="md" class="justify-center">
        <svg slot="icon-start" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path>
        </svg>
        Descargar PDF
      </Button>
      <Button href="/api/descarga/ics" variant="outline" size="md" class="justify-center !text-violet !border-violet">
        Agregar cierres a mi calendario
      </Button>
    </div>
  </div>

  <div class="flex items-end justify-between gap-3 px-1">
    <h2 class="m-0 font-display text-3xl leading-none text-paper [text-shadow:0_3px_0_rgba(29,33,82,.2)]">Convocatorias y tips</h2>
    <span class="font-mono text-[10px] font-semibold uppercase tracking-[.12em] text-paper/75">Tu ruta</span>
  </div>

  {confirmadas.length > 0 ? (
    <div class="flex flex-col gap-3">
      {confirmadas.map((p) => (
        <TarjetaConvocatoria postulacion={p} tip={tipsPorConvocatoria.get(p.id)} />
      ))}
    </div>
  ) : (
    <p class="m-0 rounded-[20px] border-2 border-paper bg-paper/95 p-5 text-[15px] leading-relaxed text-ink shadow-[0_6px_0_rgba(29,33,82,.14)]">
      Las convocatorias se confirman pronto. Tu código sigue funcionando: vuelve a esta página más
      adelante para ver fechas y tips.
    </p>
  )}
</div>
