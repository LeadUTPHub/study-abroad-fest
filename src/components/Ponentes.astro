---
// Ponentes (design/canvas/Main.dc.html). Solo se publican los
// "confirmado" (CLAUDE.md regla 2): quienes están "por-confirmar"
// todavía (Carmen, Guillermo Gonzalo, Lizbeth Dávila) no aparecen aquí
// hasta que se confirme si siguen participando.
import ponentes from "../data/ponentes";
import TagPonente from "./TagPonente.astro";

const confirmados = ponentes.filter((p) => p.estado === "confirmado");
const internacionales = confirmados.filter((p) => p.grupo === "internacional");
const panel = confirmados.filter((p) => p.grupo === "panel");

const ROTACIONES = ["-1.4deg", "1.2deg", "-0.8deg", "1.4deg"];
---

<section id="ponentes" class="bg-paper-2 px-4 py-16 sm:px-8 lg:px-[120px] lg:py-24">
  <div class="mb-10 flex max-w-[720px] flex-col gap-3 lg:mb-12">
    <span class="font-mono text-[13px] font-semibold uppercase tracking-[.14em] text-violet">Ponentes</span>
    <h2 class="m-0 font-display text-4xl leading-none text-ink sm:text-5xl lg:text-[64px]">
      Voces desde varios destinos
    </h2>
    <p class="m-0 text-lg text-ink-2">
      Estudiantes y becarios que hoy están, o estuvieron, estudiando afuera.
    </p>
  </div>

  <div class="grid gap-10 lg:grid-cols-[4fr_2fr]">
    {internacionales.length > 0 && (
      <div class="flex flex-col gap-4">
        <div class="flex flex-wrap items-center gap-3 text-lg font-extrabold text-ink">
          Ponencias internacionales
          {/* bg-[#2771A5] (no bg-sky-deep): a este tamaño, sky-deep no llega
             a 4.5:1 de contraste con el texto paper (Fase 6, revisión AA). */}
          <span class="rounded-full bg-[#2771A5] px-2.5 py-1 font-mono text-xs uppercase tracking-[.12em] text-paper">
            Vlog + Zoom en vivo
          </span>
        </div>
        <div class="grid grid-cols-2 gap-5 sm:grid-cols-4">
          {internacionales.map((p, i) => (
            <TagPonente ponente={p} rotate={ROTACIONES[i % ROTACIONES.length]} />
          ))}
        </div>
      </div>
    )}

    {panel.length > 0 && (
      <div class="flex flex-col gap-4">
        <div class="flex flex-wrap items-center gap-3 text-lg font-extrabold text-ink">
          Panel de ex-becarios
          <span class="rounded-full bg-magenta px-2.5 py-1 font-mono text-xs uppercase tracking-[.12em] text-paper">
            Presencial
          </span>
        </div>
        <div class="grid grid-cols-2 gap-5">
          {panel.map((p, i) => (
            <TagPonente ponente={p} rotate={ROTACIONES[i % ROTACIONES.length]} />
          ))}
        </div>
      </div>
    )}
  </div>

  <div class="mt-11 flex flex-wrap items-center gap-4 rounded-2xl bg-sky-soft px-5 py-4 text-base font-bold text-ink max-w-[760px]">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#6258BB" stroke-width="2.2" stroke-linecap="round" class="shrink-0" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M12 11v6M12 7.2v.1"></path>
    </svg>
    El panel comparte experiencias personales. Las dudas sobre requisitos y convocatorias se resuelven en los stands.
  </div>
</section>
