---
// Avión de papel del concepto Viaje. Solo se usa dentro de un <svg>.
// `rotate` orienta la silueta base (que mira hacia arriba): 90 = derecha,
// 180 = abajo, 45 = diagonal.
interface Props {
  scale: number;
  rotate?: number;
  fill?: string;
  stroke?: string;
  strokeWidth?: number;
}
const { scale, rotate = 0, fill = "#FDFEFC", stroke, strokeWidth } = Astro.props;
---

<g transform={`scale(${scale}) translate(-12,-12)`}>
  <path
    transform={`rotate(${rotate} 12 12)`}
    fill={fill}
    stroke={stroke}
    stroke-width={strokeWidth}
    stroke-linejoin="round"
    d="M21.5 15.2v-1.8L13.6 8.5V3.3a1.6 1.6 0 1 0-3.2 0v5.2l-7.9 4.9v1.8l7.9-2.4v5.1l-2 1.5V21l3.6-1 3.6 1v-1.6l-2-1.5v-5.1z"
  ></path>
</g>
