---
// Menú con anclas (design/canvas/Main.dc.html header, adaptado a
// hamburguesa en celular como en design/canvas/Mobile.dc.html).
// Fase de marca: logo real de LEAD UTP (src/assets/marca/logo-lead.png).
// En escritorio, el header se fija y se esconde al bajar; aparece de
// nuevo apuntando el mouse arriba del todo (ver <script> al final).
import { Image } from "astro:assets";
import { lumaUrl } from "../lib/luma";
import Button from "./ui/Button.astro";
import logoLead from "../assets/marca/logo-lead.png";

const enlaces = [
  { href: "#cronograma", label: "Cronograma" },
  { href: "#ponentes", label: "Ponentes" },
  { href: "#stands", label: "Stands" },
  { href: "#calendario", label: "Calendario de becas" },
  { href: "#llegar", label: "Cómo llegar" },
];
---

<header id="nav-header" class="relative z-20 flex items-center justify-between px-4 py-3 sm:px-8 lg:px-[120px] lg:py-0 lg:h-[88px]">
  <a href="#hero" class="flex items-center gap-2.5 no-underline" aria-label="Ir al inicio">
    <Image src={logoLead} alt="LEAD UTP" width={206} height={80} class="h-8 w-auto sm:h-9 lg:h-10" />
    <span class="hidden font-semibold text-base text-paper opacity-90 sm:inline">Pilar de Excelencia Académica</span>
  </a>

  <nav class="hidden items-center gap-7 text-base font-bold text-paper lg:flex">
    {enlaces.map((e) => (
      <a href={e.href} class="no-underline hover:opacity-80">
        {e.label}
      </a>
    ))}
    <Button href={lumaUrl("nav")} variant="outline" size="sm">Inscríbete gratis</Button>
  </nav>

  <button
    id="nav-toggle"
    type="button"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="nav-panel"
    class="grid h-11 w-11 place-items-center rounded-xl border-[3px] border-paper bg-transparent lg:hidden"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FDFEFC" stroke-width="2.6" stroke-linecap="round" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16"></path>
    </svg>
  </button>

  <div
    id="nav-panel"
    data-open="false"
    class="absolute inset-x-4 top-[calc(100%+8px)] hidden flex-col gap-1 rounded-2xl border-2 border-lav bg-paper p-3 text-ink shadow-[0_10px_0_rgba(29,33,82,.16)] lg:hidden"
  >
    {enlaces.map((e) => (
      <a href={e.href} class="rounded-lg px-3 py-2.5 font-bold no-underline text-ink hover:bg-paper-2">
        {e.label}
      </a>
    ))}
    <a
      href={lumaUrl("nav-movil")}
      class="mt-1 rounded-full bg-brand-gradient px-4 py-2.5 text-center font-display text-paper no-underline"
    >
      Inscríbete gratis
    </a>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const panel = document.getElementById("nav-panel");
  if (toggle && panel) {
    toggle.addEventListener("click", () => {
      const open = panel.dataset.open === "true";
      panel.dataset.open = open ? "false" : "true";
      panel.classList.toggle("hidden", open);
      panel.classList.toggle("flex", !open);
      toggle.setAttribute("aria-expanded", open ? "false" : "true");
      toggle.setAttribute("aria-label", open ? "Abrir menú" : "Cerrar menú");
    });
    panel.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => {
        panel.dataset.open = "false";
        panel.classList.add("hidden");
        panel.classList.remove("flex");
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", "Abrir menú");
      }),
    );
  }

  // Header flotante en escritorio: al bajar más de su propia altura, se
  // saca del flujo del documento y se esconde (deslizado hacia arriba).
  // Apuntar el mouse a la franja superior de la pantalla lo trae de
  // vuelta como overlay, sin tener que scrollear hasta arriba. Solo en
  // pantallas con mouse de verdad (celular sigue con DockMovil).
  const header = document.getElementById("nav-header");
  const conMouse = window.matchMedia("(hover: hover) and (pointer: fine) and (min-width: 1024px)");
  if (header && conMouse.matches) {
    const ZONA_REVELADO = 64;
    let fijo = false;
    let visible = true;

    const revelar = () => {
      if (!fijo || visible) return;
      visible = true;
      header.classList.remove("nav-oculto");
    };
    const esconder = () => {
      if (!fijo || !visible) return;
      visible = false;
      header.classList.add("nav-oculto");
    };

    const alScrollear = () => {
      const scrolleado = window.scrollY > header.offsetHeight;
      if (scrolleado && !fijo) {
        fijo = true;
        visible = false;
        header.classList.add("nav-fijo", "nav-oculto");
      } else if (!scrolleado && fijo) {
        fijo = false;
        visible = true;
        header.classList.remove("nav-fijo", "nav-oculto");
      }
    };

    window.addEventListener("scroll", alScrollear, { passive: true });
    window.addEventListener("mousemove", (e) => {
      if (!fijo) return;
      if (e.clientY <= ZONA_REVELADO) revelar();
      else if (e.clientY > header.offsetHeight + 24) esconder();
    });
  }
</script>
