---
// Dock de CTA fijo en celular (design/canvas/Mobile.dc.html, barra
// inferior). Oculto en desktop.
import evento from "../data/evento";
import { lumaUrl } from "../lib/luma";
import { formatoFechaCorta, formatoHora12 } from "../lib/fechas";
---

<div class="fixed inset-x-0 bottom-0 z-30 flex items-center justify-between gap-3 border-t-2 border-lav bg-paper/97 px-4 py-3 backdrop-blur-sm lg:hidden">
  <div class="text-sm font-extrabold leading-tight text-ink">
    {formatoFechaCorta(evento.fecha)} · {formatoHora12(evento.horaInicio)}
    <div class="font-semibold text-ink-2">{evento.lugar} · {evento.gratuito ? "Gratis" : ""}</div>
  </div>
  <a
    href={lumaUrl("dock-movil")}
    class="btn-lift whitespace-nowrap rounded-full border-[3px] border-paper bg-brand-gradient px-4 py-2.5 font-display text-base text-paper shadow-[0_4px_0_rgba(29,33,82,.16)]"
  >
    Inscríbete
  </a>
</div>
