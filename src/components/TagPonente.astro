---
// Tarjeta de ponente tipo etiqueta de equipaje (design/canvas/Main.dc.html).
// Animación 4 (el sello "golpea" al hover) vive en global.css, disparada
// por la clase "speaker-tag" de este componente.
import { Image } from "astro:assets";
import type { Ponente } from "../data/schema";
import Sello from "./ui/Sello.astro";

interface Props {
  ponente: Ponente;
  rotate?: string;
}

const { ponente, rotate = "-1.2deg" } = Astro.props;

const esInternacional = ponente.grupo === "internacional";
const inicial = ponente.nombre
  .split(" ")
  .map((palabra) => palabra[0])
  .slice(0, 2)
  .join("")
  .toUpperCase();

// Fotos autorizadas: PLAN.md sección 6. Mientras no lleguen, se usa el
// placeholder con la inicial.
let imagenModulo: { default: ImageMetadata } | undefined;
if (ponente.imagen) {
  const imagenes = import.meta.glob<{ default: ImageMetadata }>("../assets/ponentes/*", { eager: true });
  imagenModulo = imagenes[`../assets/ponentes/${ponente.imagen}`];
}
---

<article
  class="speaker-tag relative flex flex-col gap-3 rounded-2xl border-2 border-lav bg-paper p-4 pt-9 shadow-[0_6px_0_rgba(29,33,82,.14),0_14px_28px_-14px_rgba(29,33,82,.35)] transition-transform duration-300 ease-out hover:-translate-y-2 hover:rotate-0"
  style={`transform: rotate(${rotate})`}
>
  <span class="absolute left-1/2 top-3 h-[18px] w-[18px] -translate-x-1/2 rounded-full border-[3px] border-lav bg-paper-2" aria-hidden="true"></span>

  <div class:list={["relative grid h-[180px] place-items-center rounded-xl", esInternacional ? "bg-sky-soft" : "bg-[#F3DDF3]"]}>
    {imagenModulo ? (
      <Image
        src={imagenModulo.default}
        alt={ponente.nombre}
        width={200}
        height={200}
        class="h-full w-full rounded-xl object-cover"
      />
    ) : (
      <b class:list={["font-display text-[46px] leading-none", esInternacional ? "text-sky-deep" : "text-magenta"]}>
        {inicial}
      </b>
    )}
    {ponente.codigoPais && (
      <div class="stamp-mark absolute bottom-2.5 right-2.5">
        <Sello color={esInternacional ? "#AC0BAD" : "#6258BB"}>{ponente.codigoPais}</Sello>
      </div>
    )}
  </div>

  <div class="font-extrabold leading-tight text-ink">{ponente.nombre}</div>
  {ponente.institucion && <div class="font-bold text-violet">{ponente.institucion}</div>}
  {ponente.meta && (
    <div class="font-mono text-xs uppercase tracking-[.08em] text-ink-2">{ponente.meta}</div>
  )}
</article>
